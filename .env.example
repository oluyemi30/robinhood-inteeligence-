# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Robinhood Chain Configuration
RH_CHAIN_ID=4663
RH_RPC_URL="https://rpc.robinhood.com"
RH_WS_URL="wss://rpc.robinhood.com"

# Blockchain Data Providers
ALCHEMY_API_KEY=""
BITQUERY_API_KEY=""
GMGN_API_KEY=""

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Database & Cache (Optional remote instances, in-memory state engine fallback active by default)
DATABASE_URL=""
REDIS_URL=""
